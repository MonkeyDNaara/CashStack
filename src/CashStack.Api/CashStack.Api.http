@host = http://localhost:5198
@base = {{host}}/api/v1/transactions
# Fixed ids of seeded categories (DefaultCategories)
@groceries = 6f0b8a52-1c3e-4c1a-9a51-000000000201
@salary = 6f0b8a52-1c3e-4c1a-9a51-000000000101

### List: current month (default range)
GET {{base}}
Accept: application/json

### List: date range + type filter
GET {{base}}?from=2026-10-01&to=2026-10-31&type=Expense
Accept: application/json

### Summary: current month
GET {{base}}/summary
Accept: application/json

### Summary: date range (incl. totals per category for a chart)
GET {{base}}/summary?from=2026-10-01&to=2026-10-31
Accept: application/json

### List: filter by category (200)
GET {{base}}?categoryId={{groceries}}
Accept: application/json

### Create (201 + Location header)
# @name create
POST {{base}}
Content-Type: application/json

{
  "type": "Expense",
  "categoryId": "{{groceries}}",
  "description": "Weekly shopping",
  "amount": 42.50
}

### Create with a past date (201, timestamp = that day at the current time)
POST {{base}}
Content-Type: application/json

{
  "type": "Expense",
  "categoryId": "{{groceries}}",
  "description": "September shopping",
  "amount": 30,
  "date": "2026-09-15"
}

### Create with a future date (400, field error for "date")
POST {{base}}
Content-Type: application/json

{
  "type": "Expense",
  "categoryId": "{{groceries}}",
  "description": "Future",
  "amount": 10,
  "date": "2099-01-01"
}

### Get by id (uses the id returned by "create")
GET {{base}}/{{create.response.body.$.id}}
Accept: application/json

### Delete (uses the id returned by "create", 204)
DELETE {{base}}/{{create.response.body.$.id}}

### Get by id: unknown id (404)
GET {{base}}/00000000-0000-0000-0000-000000000000

### List: invalid type (400)
GET {{base}}?type=xyz

### List: from after to (400, ValidateDateRange filter)
GET {{base}}?from=2026-12-01&to=2026-11-01

### Summary: only from, after today (400, to defaults to today)
GET {{base}}/summary?from=2099-01-01

### Create: missing type (400)
POST {{base}}
Content-Type: application/json

{
  "categoryId": "{{groceries}}",
  "description": "No type",
  "amount": 10
}

### Create: missing categoryId (400)
POST {{base}}
Content-Type: application/json

{
  "type": "Expense",
  "description": "No category",
  "amount": 10
}

### Create: category of the wrong type (400, Salary is an income category)
POST {{base}}
Content-Type: application/json

{
  "type": "Expense",
  "categoryId": "{{salary}}",
  "description": "Wrong type",
  "amount": 10
}

### Create: unknown category (400)
POST {{base}}
Content-Type: application/json

{
  "type": "Expense",
  "categoryId": "00000000-0000-0000-0000-000000000000",
  "description": "Unknown category",
  "amount": 10
}

### Create: invalid amount and description (400, several errors)
POST {{base}}
Content-Type: application/json

{
  "type": "Income",
  "categoryId": "{{salary}}",
  "description": " ",
  "amount": 1.234
}

# ---------- Categories ----------
# Ids of the protected "Other" categories (DefaultCategories)
@categories = {{host}}/api/v1/categories
@otherIncome = 6f0b8a52-1c3e-4c1a-9a51-000000000001
@otherExpense = 6f0b8a52-1c3e-4c1a-9a51-000000000002

### Categories: list all (200, Income first, then by name)
GET {{categories}}
Accept: application/json

### Categories: list by type (200)
GET {{categories}}?type=Expense
Accept: application/json

### Categories: invalid type (400)
GET {{categories}}?type=xyz

### Categories: get by id (200, isProtected = true)
GET {{categories}}/{{otherExpense}}
Accept: application/json

### Categories: get unknown id (404)
GET {{categories}}/00000000-0000-0000-0000-000000000000

### Categories: create (201 + Location header)
# @name createCategory
POST {{categories}}
Content-Type: application/json

{
  "name": "Subscriptions",
  "type": "Expense"
}

### Categories: create duplicate, other case (409)
POST {{categories}}
Content-Type: application/json

{
  "name": "  subscriptions ",
  "type": "Expense"
}

### Categories: same name for the other type (201)
POST {{categories}}
Content-Type: application/json

{
  "name": "Subscriptions",
  "type": "Income"
}

### Categories: create without type, name too long (400)
POST {{categories}}
Content-Type: application/json

{
  "name": "This name is far too long for a category, it has more than fifty characters"
}

### Categories: rename (200)
PUT {{categories}}/{{createCategory.response.body.$.id}}
Content-Type: application/json

{
  "name": "Streaming"
}

### Categories: rename to an existing name (409)
PUT {{categories}}/{{createCategory.response.body.$.id}}
Content-Type: application/json

{
  "name": "Groceries"
}

### Categories: rename protected "Other" (409)
PUT {{categories}}/{{otherIncome}}
Content-Type: application/json

{
  "name": "Misc"
}

### Categories: rename unknown id (404)
PUT {{categories}}/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "name": "Misc"
}

### Categories: delete protected "Other" (409)
DELETE {{categories}}/{{otherExpense}}

### Categories: delete (204)
DELETE {{categories}}/{{createCategory.response.body.$.id}}

### Categories: delete again (404)
DELETE {{categories}}/{{createCategory.response.body.$.id}}

### Categories: create one and use it in a transaction (201)
# @name usedCategory
POST {{categories}}
Content-Type: application/json

{
  "name": "Insurance",
  "type": "Expense"
}

### Transactions: create with the new category (201)
POST {{base}}
Content-Type: application/json

{
  "type": "Expense",
  "categoryId": "{{usedCategory.response.body.$.id}}",
  "description": "Liability insurance",
  "amount": 60
}

### Categories: delete a category in use (409)
DELETE {{categories}}/{{usedCategory.response.body.$.id}}
